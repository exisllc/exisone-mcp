  "repository": {
    "type": "git",
    "url": "https://github.com/exlodiern/exisone-mcp"
  },
  "homepage": "https://www.exisone.com/docs-ai-mcp.html",
  "bugs": {
    "url": "https://github.com/exlodiern/exisone-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }

# ExisOne MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: ExisOne API URL (must be HTTPS)
EXISONE_API_URL=https://www.exisone.com

# Required: Your API access token from ExisOne dashboard
# Format: exo_at_{publicId}_{secret}
# Get yours at: https://www.exisone.com/tokens.html
EXISONE_ACCESS_TOKEN=exo_at_your_public_id_your_secret

# Required: Your tenant ID (visible in dashboard settings)
EXISONE_TENANT_ID=1

# Optional: Request timeout in milliseconds (default: 30000)
EXISONE_TIMEOUT=30000
